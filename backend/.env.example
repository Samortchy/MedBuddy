# MedBuddy Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ─── FastAPI ─────────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Agora (Phase 4) ─────────────────────────────────────────────────────────
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# ─── Firebase FCM (Phase 2 — Bakr) ───────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=base64-encoded-service-account-json

# ─── Twilio SMS (Phase 2 — postponed #25) ────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ─── AI Models (Phase 3 — Ali) ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
WHISPER_MODEL_SIZE=large-v3
CHATTERBOX_MODEL_PATH=./models/chatterbox
